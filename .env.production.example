# ==================================================
# 🚜 FARM SEVA — PRODUCTION ENVIRONMENT MANDATORY TEMPLATE
# ==================================================
# WARNING: NEVER COMMIT ACTUAL PRODUCTION VALUES OR SECRETS TO GIT.
# Load these environment variables via your production secret manager (AWS Secrets Manager, GCP Secret Manager, Vault, etc.)

# --------------------------------------------------
# 1. APPLICATION ENVIRONMENT & CORE SECRETS (MANDATORY)
# --------------------------------------------------
NODE_ENV=production
PORT=4000
NEXT_PUBLIC_API_URL="https://api.your-domain.com"
PILOT_MODE=true
PILOT_SUPPORTED_STATES="Andhra Pradesh,Telangana,Karnataka,Maharashtra,Tamil Nadu"

# Cryptographic Keys (MUST BE GENERATED WITH SECURE RANDOM PRNG - MIN 32 CHARACTERS)
JWT_SECRET="<MANDATORY_PROD_JWT_SECRET_MIN_32_CHARS>"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="<MANDATORY_PROD_REFRESH_SECRET_MIN_32_CHARS>"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Seller Bank Detail AES-256-GCM Encryption Secret (MUST BE EXACTLY 32 BYTES)
ENCRYPTION_SECRET="<MANDATORY_32_BYTE_AES256_ENCRYPTION_SECRET>"

# --------------------------------------------------
# 2. DATABASE & REDIS INFRASTRUCTURE (MANDATORY)
# --------------------------------------------------
# Managed PostgreSQL Connection String with SSL/TLS
DATABASE_URL="postgresql://farmseva_db_user:<PROD_PASSWORD>@db.production.farmseva.in:5432/farmseva_prod?sslmode=require&connection_limit=20"

# Production Managed Redis Instance
REDIS_URL="redis://:redispw@redis.production.farmseva.in:6379"

# Strict Production Allowed Origins
CORS_ORIGINS="https://farmseva.in,https://admin.farmseva.in,https://seller.farmseva.in"

# --------------------------------------------------
# 3. PRODUCTION OBJECT STORAGE (MANDATORY)
# --------------------------------------------------
STORAGE_PROVIDER="S3" # S3 or R2
S3_BUCKET_NAME="farm-seva-prod-assets"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="<PROD_AWS_ACCESS_KEY>"
AWS_SECRET_ACCESS_KEY="<PROD_AWS_SECRET_KEY>"

# --------------------------------------------------
# 4. EXTERNAL PROVIDER CREDENTIALS
# --------------------------------------------------
# Payment Gateway (Razorpay Production)
RAZORPAY_KEY_ID="<PROD_RAZORPAY_KEY_ID>"
RAZORPAY_KEY_SECRET="<PROD_RAZORPAY_KEY_SECRET>"
RAZORPAY_WEBHOOK_SECRET="<PROD_RAZORPAY_WEBHOOK_SECRET>"

# SMS Gateway (BSNL/DLT Approved Provider)
SMS_API_KEY="<PROD_SMS_GATEWAY_KEY>"
SMS_SENDER_ID="FRMSEV"

# WhatsApp Business API
WHATSAPP_API_TOKEN="<PROD_WHATSAPP_BEARER_TOKEN>"
WHATSAPP_PHONE_NUMBER_ID="<PROD_WHATSAPP_PHONE_ID>"

# Telephony / IVR Gateway
IVR_API_KEY="<PROD_TELEPHONY_API_KEY>"
IVR_CALL_CENTER_NUMBER="1800-XXX-FARM"

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY="<PROD_FCM_SERVER_KEY>"

# Seller Payout Gateway (Razorpay Route / Cashfree Payouts)
PAYOUT_API_KEY="<PROD_PAYOUT_API_KEY>"
