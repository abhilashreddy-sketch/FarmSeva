# ==================================================
# 🚜 FARM SEVA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@db_host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@db_host:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://your_supabase_project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Authentication & Security Secrets
JWT_SECRET="your_jwt_secret_min_32_characters"
REFRESH_TOKEN_SECRET="your_refresh_token_secret"
ENCRYPTION_SECRET="your_encryption_secret_32_bytes"

# Server Configuration
PORT=4000
NODE_ENV=development
NEXT_PUBLIC_API_URL="http://localhost:4000"

# AI Vision Provider Configuration (Google Gemini)
AI_PROVIDER=GEMINI
AI_API_KEY=your_google_gemini_api_key
AI_MODEL=gemini-3.8-flash

# Multilingual Text-to-Speech Provider (Optional)
TTS_PROVIDER=GOOGLE_TTS
TTS_API_KEY=your_google_tts_api_key
