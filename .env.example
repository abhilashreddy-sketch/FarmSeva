# ==================================================
# 🚜 FARM SEVA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

# --------------------------------------------------
# 1. APPLICATION ENVIRONMENT & CORE SECRETS
# --------------------------------------------------
# Status: REQUIRED
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
PILOT_MODE=true
PILOT_SUPPORTED_STATES="Andhra Pradesh,Telangana,Karnataka,Maharashtra,Tamil Nadu"

# Status: REQUIRED (Development Default; Overridden in Production)
JWT_SECRET="farm-seva-dev-secret-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="farm-seva-refresh-secret-key-change-in-production"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Status: REQUIRED (32-Byte Secret for Seller Bank Detail AES-256-GCM Encryption)
ENCRYPTION_SECRET="farm-seva-default-32-byte-secret-key-prod!!"

# --------------------------------------------------
# 2. DATABASE & REDIS INFRASTRUCTURE (SUPABASE POSTGRESQL)
# --------------------------------------------------
# Status: REQUIRED (Supabase PostgreSQL Connection Strings for Project: dyzcxyrbfdkhmxudqehf)
# Supabase Transaction Pooler (Port 6543, pgbouncer):
DATABASE_URL="postgresql://postgres.dyzcxyrbfdkhmxudqehf:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432, for migrations/CLI):
DIRECT_URL="postgresql://postgres.dyzcxyrbfdkhmxudqehf:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://dyzcxyrbfdkhmxudqehf.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# STRICT SECURITY: SUPABASE_SERVICE_ROLE_KEY MUST ONLY BE USED SERVER-SIDE (apps/api)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Status: REQUIRED (Redis Connection for Queues & Caching)
REDIS_URL="redis://localhost:6379"

# Status: REQUIRED (Allowed CORS Origins, comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --------------------------------------------------
# 3. OBJECT & PRIVATE DOCUMENT STORAGE CONFIGURATION
# --------------------------------------------------
# Status: OPTIONAL (LOCAL / S3 / R2 / SUPABASE_STORAGE)
STORAGE_PROVIDER="LOCAL"
S3_BUCKET_NAME=""
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_URL=""
SUPABASE_STORAGE_SERVICE_KEY=""

# --------------------------------------------------
# 4. EXTERNAL PROVIDER CREDENTIALS & ADAPTERS
# --------------------------------------------------
# Status: OPTIONAL (When empty, adapters report WAITING_FOR_PROVIDER / NOT_CONFIGURED status)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMS Provider Key (MSG91 / Twilio / Fast2SMS)
SMS_PROVIDER_KEY=""
SMS_API_KEY=""
SMS_SENDER_ID=""

# KYC Gateway Provider (Karza / SurePass / Razorpay KYC)
KYC_PROVIDER_KEY=""
KYC_PROVIDER_NAME="KARZA_LIVE"

WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

IVR_API_KEY=""
