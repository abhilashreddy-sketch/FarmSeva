# ==============================================================================
# FARM SEVA REST API — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Copy this file to .env on your production host or configure these keys
# directly in your cloud hosting provider's Secrets Manager (Render, Railway, AWS, DigitalOcean).
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=4000

# Security Secrets (CRITICAL: Must be unique, min 32 random characters for JWT/encryption)
JWT_SECRET=production_jwt_secret_min_32_characters_random_string_here_change_me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=production_refresh_token_secret_min_32_characters_random_string_here
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_SECRET=production_encryption_secret_32bytes_key_here!!
BCRYPT_SALT_ROUNDS=12

# Database Connection (Supabase PostgreSQL)
# Use PgBouncer transaction pooler (port 6543) for DATABASE_URL in serverless/container apps
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"
# Use direct connection (port 5432) for DIRECT_URL during Prisma schema migrations
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS Security (Comma-separated exact origins for all 5 web frontends)
CORS_ORIGINS=https://farmer.farmseva.com,https://seller.farmseva.com,https://expert.farmseva.com,https://delivery.farmseva.com,https://admin.farmseva.com,https://farmseva.com

# Pilot Regional Scope
PILOT_MODE=true
PILOT_SUPPORTED_STATES=Andhra Pradesh,Telangana,Karnataka,Maharashtra,Tamil Nadu

# Third-Party Real Provider Credentials

# 1. Payment Gateway (Razorpay Live Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 2. SMS & OTP Delivery (MSG91 / Twilio)
# For MSG91:
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=FRMSEV
MSG91_DLT_TE_ID_OTP=1707xxxxxxxxxxxxxxx
# For Twilio (alternative):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 3. WhatsApp Business API
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# 4. Cloud Asset Storage (AWS S3 or Cloudflare R2 for Images & KYC Documents)
STORAGE_PROVIDER=S3
S3_BUCKET_NAME=farm-seva-production-assets
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# 5. Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.farmseva.com/api/v1/auth/google/callback

# 6. AI Vision & Diagnostic Model
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your_google_gemini_api_key
AI_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-2.5-flash
